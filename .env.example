# =============================================================================
# Skilved — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local to git.
# Full reference: docs/16_Environment_Variables.md
# =============================================================================

# GCP Core
GCP_PROJECT_ID=skilved-dev
GCP_REGION=africa-south1

# Firebase / Firestore
FIREBASE_PROJECT_ID=skilved-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=skilved-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=skilved-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google AI / Gemini
GEMINI_API_KEY=

# Vertex AI
VERTEX_AI_PROJECT=skilved-dev
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_SEARCH_ENGINE_ID=
VERTEX_AI_RANKING_CONFIG=

# BigQuery
BIGQUERY_PROJECT_ID=skilved-dev
BIGQUERY_DATASET=skilved_dev
BIGQUERY_LOCATION=africa-south1

# Redis (Cloud Memorystore — skip in dev, use in-memory cache)
REDIS_ENABLED=false
REDIS_URL=
REDIS_PASSWORD=

# WhatsApp Business API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Auth (NextAuth)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ATS Adapters
CAPTCHA_SOLVER_API_KEY=
CAPTCHA_SOLVER_PROVIDER=2captcha

# External Verification APIs
SAQA_API_URL=https://regqs.saqa.org.za
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
ID_HASH_SALT=

# Feature Flags (dev defaults)
FEATURE_APPLICATION_AGENT=false
FEATURE_DOCUMENT_VAULT=false
FEATURE_VERTEX_AI_SEARCH=false
FEATURE_SKILLS_PULSE=true
FEATURE_CAREER_SIMULATION=false
FEATURE_EMPLOYER_ACCOUNTABILITY=false

# Emulator overrides (set by firebase-env-setup.sh for local dev)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
