# =============================================================================
# Skilved — Environment Variables Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this template to .env.local: cp .env.example .env.local
# 2. Never commit .env.local or any credentials to version control.
# 3. Exhaustive schema specification, validation rules, and secret policies:
#    docs/current/engineering/11_ENVIRONMENT_SCHEMA_AND_CONFIGURATION.md
# =============================================================================

# =============================================================================
# 1. PUBLIC_CLIENT VARIABLES
# Exposed to client browser (Next.js NEXT_PUBLIC_* prefix).
# MUST NOT contain secrets, private keys, or internal VPC hostnames.
# =============================================================================
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Client SDK Configuration (Safe for public browser distribution)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=skilved-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=skilved-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=skilved-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# =============================================================================
# 2. LOCAL EMULATOR OVERRIDES
# Safe loopback endpoints for local offline development.
# Prevents cloud billing and isolates development state.
# =============================================================================
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
PUBSUB_EMULATOR_HOST=127.0.0.1:8085

# =============================================================================
# 3. SERVER_RUNTIME CONFIGURATION
# Server-side runtime context, service boundaries, endpoints, and toggles.
# Non-sensitive configuration; consumed by Node.js server and Cloud Run Jobs.
# =============================================================================
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
PORT=3000

# GCP Topology & Regional Infrastructure
GCP_PROJECT_ID=skilved-dev
GCP_REGION=africa-south1
FIREBASE_PROJECT_ID=skilved-dev

# Auth Server URL
NEXTAUTH_URL=http://localhost:3000

# Vertex AI Engine
VERTEX_AI_PROJECT=skilved-dev
VERTEX_AI_LOCATION=africa-south1
VERTEX_AI_SEARCH_ENGINE_ID=
VERTEX_AI_RANKING_CONFIG=

# BigQuery Analytics (disabled by default in dev; falls back gracefully)
BIGQUERY_PROJECT_ID=skilved-dev
BIGQUERY_DATASET=skilved_dev
BIGQUERY_LOCATION=africa-south1
BIGQUERY_ENABLED=false

# Redis Cache (Cloud Memorystore; disabled in dev, falls back to in-memory)
REDIS_ENABLED=false
REDIS_URL=

# ATS Crawlers & External Adapters
CAPTCHA_SOLVER_PROVIDER=2captcha
SAQA_API_URL=https://regqs.saqa.org.za

# Feature Flags (Sprint 1 / M0 Defaults)
FEATURE_APPLICATION_AGENT=false
FEATURE_DOCUMENT_VAULT=false
FEATURE_VERTEX_AI_SEARCH=false
FEATURE_SKILLS_PULSE=true
FEATURE_CAREER_SIMULATION=false
FEATURE_EMPLOYER_ACCOUNTABILITY=false
FEATURE_IN_APP_APPLY=false
FEATURE_MYMZANSI_VERIFY=false

# =============================================================================
# 4. OPERATOR_SECRET VARIABLES
# ZERO SECRETS POLICY: Never set actual secrets in this file or commit to VCS.
# In production, these are injected via Google Secret Manager in africa-south1.
# In local development, generate synthetic test keys in private .env.local.
# =============================================================================

# Firebase Admin Service Account Credentials
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Auth Session Signing Key (Generate dev key: openssl rand -base64 32)
NEXTAUTH_SECRET=

# Google Gemini / AI Studio API
GEMINI_API_KEY=

# Redis Authentication
REDIS_PASSWORD=

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ATS Captcha Solver Service
CAPTCHA_SOLVER_API_KEY=

# Payment Gateway (PayFast)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=

# Cryptographic Salt for POPIA-compliant South African ID Hashing
ID_HASH_SALT=
