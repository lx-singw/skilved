{
  "name": "skilved",
  "version": "1.0.0",
  "private": true,
  "description": "Skilved \u2014 AI-powered skills opportunity platform for South Africa",
  "workspaces": [
    "apps/*",
    "apps/agents/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "web:lint": "pnpm --filter @skilved/web lint",
    "web:typecheck": "pnpm --filter @skilved/web typecheck",
    "web:build": "pnpm --filter @skilved/web build",
    "web:test": "pnpm --filter @skilved/web test:boundary",
    "contracts:typecheck": "pnpm --filter @skilved/types typecheck:contracts",
    "contracts:test": "pnpm --filter @skilved/types test:contracts",
    "contracts:inspect": "pnpm --filter @skilved/types inspect:contracts"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
