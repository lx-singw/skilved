# Exclude everything, including .git, private env files, snapshots and evaluation data.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/
!apps/web/
!apps/web/package.json
!apps/web/next.config.js
!apps/web/tsconfig.json
!apps/web/next-env.d.ts
!apps/web/postcss.config.js
!apps/web/tailwind.config.ts
!apps/web/eslint.config.mjs
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**
!packages/
!packages/types/
!packages/types/package.json
!packages/types/src/
!packages/types/src/**
!packages/types/tsconfig.contracts.json
!packages/catalogue/
!packages/catalogue/package.json
!packages/catalogue/src/
!packages/catalogue/src/**
!deployment/
!deployment/catalogue-staging/
!deployment/catalogue-staging/runtime/
!deployment/catalogue-staging/runtime/**
# Defense against credentials accidentally placed beneath an allowed source folder.
**/.env*
**/*.pem
**/*.key
**/credentials*.json
**/service-account*.json
**/service_account*.json
**/.artifacts/**
**/node_modules/**
