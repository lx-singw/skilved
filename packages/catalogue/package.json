{
  "name": "@skilved/catalogue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/http.mjs",
    "./runtime": "./src/runtime.mjs",
    "./suggestions": "./src/suggestion-runtime.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:adapters": "node --test tests/recentjobs.test.mjs",
    "test:extraction": "node --test tests/extraction.test.mjs",
    "extract:recentjobs": "node tools/extract-recentjobs.mjs",
    "plan:recentjobs": "node tools/plan-recentjobs-programmes.mjs",
    "plan:publisher": "node tools/plan-recentjobs-publisher.mjs",
    "worker:recentjobs": "node tools/run-recentjobs.mjs",
