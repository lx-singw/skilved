    "check:staging-reads": "node tools/check-staging-reads.mjs",
    "shadow:recentjobs": "node tools/shadow-recentjobs.mjs",
    "checkpoint:shadow": "node tools/export-shadow-checkpoint.mjs",
    "evaluate:recentjobs": "node tools/evaluate-recentjobs.mjs",
    "inventory:source-exposure": "node tools/inventory-source-exposure.mjs",
    "coverage:recentjobs": "node tools/assess-recentjobs-coverage.mjs",
    "onboard:employers": "node tools/collect-employers.mjs",
    "operator": "node tools/operator.mjs"
  },
  "dependencies": {
    "@skilved/types": "workspace:*",
    "fast-xml-parser": "5.11.1",
    "firebase-admin": "^13.0.0",
    "google-auth-library": "10.9.1",
    "ipaddr.js": "^2.2.0",
    "parse5": "8.0.0",
    "robots-parser": "3.0.1",
    "tldts": "7.4.19",
    "zod": "^3.22.4",
    "zod-to-json-schema": "3.25.2"
