{
  "name": "@skilved/types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript types & Zod schemas for Skilved",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "zod": "^3.22.4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./opportunities": {
      "types": "./src/opportunities/index.ts",
      "default": "./dist/opportunities/index.js"
    },
    "./opportunities/internal": {
      "types": "./src/opportunities/internal.ts",
      "default": "./dist/opportunities/internal.js"
    },
    "./opportunities/storage": {
      "types": "./src/opportunities/storage.ts",
      "default": "./dist/opportunities/storage.js"
    },
    "./opportunities/migration": {
      "types": "./src/opportunities/migration.ts",
      "default": "./dist/opportunities/migration.js"
    },
    "./legacy": "./src/opportunity.ts"
  },
  "scripts": {
    "typecheck:contracts": "tsc -p tsconfig.contracts.json --noEmit",
    "build:contracts": "tsc -p tsconfig.contracts.json",
    "test:contracts": "pnpm build:contracts && node --test tests/*.test.mjs",
    "inspect:contracts": "pnpm build:contracts && node tools/inspect.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
